# Paper 10.1 Benchmark - S1 @ 6000 keV, th=2.0 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S1
/DetectorConstruction/Sample_Thickness 2.0000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 6000 keV
/gun/position 0 0 0 cm
# huong: dang huong, ngau nhien moi event (MyPrimaryGeneratorAction)

/analysis/setFileName hist_S1_2.0cm_6000keV
/run/beamOn @PRIMARIES@
