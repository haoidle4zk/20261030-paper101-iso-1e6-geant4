# Paper 10.1 Benchmark - S4 @ 60 keV, th=2.5 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S4
/DetectorConstruction/Sample_Thickness 2.5000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 60 keV
/gun/position 0 0 0 cm
# huong: dang huong, ngau nhien moi event (MyPrimaryGeneratorAction)

/analysis/setFileName hist_S4_2.5cm_60keV
/run/beamOn @PRIMARIES@
