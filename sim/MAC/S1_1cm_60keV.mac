# Paper 10.1 Benchmark - S1 @ 60 keV, th=1.0 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S1
/DetectorConstruction/Sample_Thickness 1.0000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 60 keV
/gun/position 0 0 0 cm
# huong: dang huong, ngau nhien moi event (MyPrimaryGeneratorAction)

/analysis/setFileName hist_S1_1.0cm_60keV
/run/beamOn @PRIMARIES@
