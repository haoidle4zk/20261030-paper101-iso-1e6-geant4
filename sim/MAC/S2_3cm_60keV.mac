# Paper 10.1 Benchmark - S2 @ 60 keV, th=3.0 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S2
/DetectorConstruction/Sample_Thickness 3.0000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 60 keV
/gun/position 0 0 0 cm
# huong: dang huong, ngau nhien moi event (MyPrimaryGeneratorAction)

/analysis/setFileName hist_S2_3.0cm_60keV
/run/beamOn @PRIMARIES@
